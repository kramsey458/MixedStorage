<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>MixedStorage.MultiplayerBridge</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Version>0.5.7</Version>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Timberborn</GameDir>
    <BeaverBuddiesPath Condition="'$(BeaverBuddiesPath)' == ''">$(UserProfile)\Documents\Timberborn\Mods\BeaverBuddies-StabilityPreview\version-1.1\BeaverBuddies.dll</BeaverBuddiesPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../source/MixedStorage.csproj" Private="false" />
    <Reference Include="$(BeaverBuddiesPath)" Private="false" />
    <Reference Include="$(GameDir)\Timberborn_Data\Managed\Timberborn.*.dll" Private="false" />
    <Reference Include="$(GameDir)\Timberborn_Data\Managed\UnityEngine*.dll" Private="false" />
  </ItemGroup>
</Project>
