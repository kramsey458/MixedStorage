<Project>
  <!-- The mod's version, the one place it is set for code. MixedStorage.dll and the multiplayer bridge are both built
       with it (and the startup log line reads it from the assembly). build.ps1 refuses to build when
       packaging/MixedStorage/version-1.1/manifest.json says otherwise, and to package a DLL built with another. -->
  <PropertyGroup>
    <Version>1.1.1</Version>
  </PropertyGroup>
</Project>
