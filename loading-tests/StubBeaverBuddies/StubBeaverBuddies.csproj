<Project Sdk="Microsoft.NET.Sdk">
  <!-- A BeaverBuddies build whose API differs from the one the bridge was compiled against. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>BeaverBuddies</AssemblyName>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Timberborn</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(GameDir)\Timberborn_Data\Managed\Timberborn.BaseComponentSystem.dll" Private="false" />
  </ItemGroup>
</Project>
